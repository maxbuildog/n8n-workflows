    {
      "id": "63faf69e-e742-4c36-93d9-a5b87e33f8c3",
      "name": "Build Shopify event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        540
      ],
      "parameters": {
        "jsCode": "const fulfillments = ($input.first().json.fulfillments) || [];\nconst ctx = $('Merge delivery data').first().json;\nconst tracking = ctx.tracking_number;\nconst order_id = ctx.order_number;\nconst status17 = ctx.shipment_status_17;\nlet shopify_status = '';\nlet message = '';\nif (status17 === 'Delivered') { shopify_status = 'delivered'; message = 'Delivered'; }\nelse if (status17 === 'OutForDelivery') { shopify_status = 'out_for_delivery'; message = 'Out for delivery'; }\nconst f = fulfillments.find(fl => (fl.tracking_number === tracking) || ((fl.tracking_numbers || []).includes(tracking)));\nif (!f) return [{ json: { skip: true, reason: 'no fulfillment found', tracking_number: tracking } }];\nreturn [{ json: {\n  order_id,\n  fulfillment_id: f.id,\n  shopify_status,\n  message,\n  tracking_number: tracking,\n  order_name: ctx.order_name,\n  email: ctx.email\n} }];"
      }
    },
    {
      "id": "5b1e7f0a-3c42-4d9e-8a16-0c7d2f9b6e11",
      "name": "Fulfillment found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        3520,
        540
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notEquals"
              }
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          }
        },
        "options": {}
      },
      "notes": "Stops here when Build Shopify event returned a skip marker (no fulfillment matches the tracking number): nothing is written to Shopify."
    },
    {
      "id": "005cd527-178a-4951-be34-e4df35f8c606",
      "name": "Shopify POST Event",
