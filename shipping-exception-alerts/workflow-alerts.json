      "name": "Verify push token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Shared-secret check. The push URL registered at 17TRACK must end with ?token=<TRACK17_WEBHOOK_TOKEN>.\n// Both values are hashed first so the comparison is constant time whatever their lengths.\n// Fails closed: if TRACK17_WEBHOOK_TOKEN is not set, every push is rejected.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst expected = $env.TRACK17_WEBHOOK_TOKEN || '';\nconst received = String((item.json.query || {}).token || '');\nconst h = s => crypto.createHash('sha256').update(s).digest();\nconst valid = expected.length > 0 && crypto.timingSafeEqual(h(expected), h(received));\nreturn [{ json: { valid, body: valid ? item.json.body : null } }];"
