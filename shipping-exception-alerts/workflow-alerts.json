      ],
      "parameters": {
        "method": "GET",
        "url": "=https://{{ $('Shopify config').first().json.shop_domain }}/admin/api/{{ $('Shopify config').first().json.api_version }}/orders/{{ $('Merge delivery data').first().json.order_number }}/fulfillments.json",
        "sendHeaders": true,
