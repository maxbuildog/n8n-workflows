    {
      "id": "5845153d-5096-4dc9-a10d-9cc7a71304b3",
      "name": "Build Klaviyo body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2520,
        200
      ],
      "parameters": {
        "jsCode": "// Public tracking page of the store, replace with your own URL.\nconst TRACKING_PAGE_URL = 'YOUR_TRACKING_PAGE_URL';\n// Klaviyo API revision sent in the revision header of Klaviyo - Event. Klaviyo supports a revision for a limited time:\n// check the current one in the Klaviyo API documentation and bump it from time to time.\nconst KLAVIYO_REVISION = '2025-10-15';\nconst d = $input.first().json;\nconst body = {\n  data: {\n    type: 'event',\n    attributes: {\n      metric: { data: { type: 'metric', attributes: { name: 'Delivery Problem' } } },\n      profile: { data: { type: 'profile', attributes: { email: d.email } } },\n      properties: {\n        order_number: d.order_name || '',\n        tracking_number: d.tracking_number || '',\n        problem_type: d.problem_status || '',\n        problem_description: d.description || d.sub_status || d.problem_status || '',\n        tracking_url: TRACKING_PAGE_URL + '?tracking=' + (d.tracking_number || ''),\n        carrier: d.carrier || '',\n        sub_status: d.sub_status || ''\n      }\n    }\n  }\n};\nreturn [{ json: { klaviyo_revision: KLAVIYO_REVISION, klaviyoBody: body, email: d.email, tracking_number: d.tracking_number, order_name: d.order_name, problem_status: d.problem_status, sub_status: d.sub_status } }];"
      }
    },
