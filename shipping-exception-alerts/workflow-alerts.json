{
  "name": "Proactive shipping exception alerts (17TRACK webhooks + Shopify)",
  "nodes": [
    {
      "id": "a89f454b-34fd-4459-b94d-cc30b7cbc335",
      "name": "Webhook 17TRACK Push",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "carrier-tracking-events",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "3ac153b8-0768-429b-818f-0234c9c3a6b7",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        660,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\": \"ok\"}",
        "options": {}
      }
    },
    {
      "id": "967d466f-d08b-4908-8079-55fa3e02c2d4",
      "name": "Extract tracking from push",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": "// The push only tells us WHICH tracking number to re-read. Its status is never used for decisions.\nconst payload = $input.first().json.body || {};\nconst data = payload.data || {};\nconst numbers = new Set();\nfor (const t of (data.accepted || [])) { if (t && t.number) numbers.add(String(t.number)); }\nif (data.number) numbers.add(String(data.number));\nif (numbers.size === 0) return []; // nothing to re-read, the run stops here\nreturn [...numbers].map(n => ({ json: { tracking_number: n } }));"
      }
    },
    {
      "id": "3f32cd01-5ab3-4337-a9e8-84f06772700f",
      "name": "17TRACK gettrackinfo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.17track.net/track/v2.4/gettrackinfo",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "=[{\"number\": \"{{ $json.tracking_number }}\"}]",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "17TRACK token (header 17token)"
        }
      }
    },
    {
      "id": "6f555db4-794a-4727-903a-f21bde1199e8",
      "name": "Extract 17TRACK status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "jsCode": "// Status comes ONLY from gettrackinfo (re-read at 17TRACK), never from the push body.\nconst push = $('Extract tracking from push').first().json;\nconst tr = $input.first().json;\nconst accepted = (tr.data && tr.data.accepted) || [];\nconst a = accepted.find(x => String(x.number) === push.tracking_number) || accepted[0];\nlet status = '';\nlet sub_status = '';\nlet description = '';\nlet latest_event_time = null;\nlet carrier_code = '';\nif (a) {\n  const ti = a.track_info || {};\n  const ls = ti.latest_status || {};\n  const le = ti.latest_event || {};\n  status = ls.status || '';\n  sub_status = ls.sub_status || '';\n  description = (le.description_translation && le.description_translation.description) || le.description || '';\n  latest_event_time = le.time_iso || null;\n  carrier_code = a.carrier || '';\n}\nreturn [{ json: { tracking_number: push.tracking_number, status, sub_status, description, latest_event_time, carrier_code } }];"
      }
    },
