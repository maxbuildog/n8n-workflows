{
  "name": "Shipping alerts: tracking number to order index (Shopify fulfillment webhook)",
  "nodes": [
    {
      "id": "57b1a1f0-557f-415f-9047-22c274b5fa3a",
      "name": "Shopify Fulfillment Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "shopify-fulfillment-created",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      }
    },
    {
      "id": "a52e8407-b474-4394-b71f-b057d393976e",
      "name": "Extract tracking + order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        690,
        300
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst results = [];\n\nconst orderName = body.order_name || body.name || '';\nconst orderId = body.order_id || body.id || '';\nconst email = body.email || (body.destination && body.destination.email) || '';\n\nconst trackingNumbers = body.tracking_numbers || [];\nconst trackingNumber = body.tracking_number || '';\nconst carrier = body.tracking_company || '';\n\nif (trackingNumbers.length > 0) {\n  for (const tn of trackingNumbers) {\n    results.push({\n      tracking_number: tn,\n      order_number: orderId.toString(),\n      order_name: orderName,\n      email: email.toLowerCase(),\n      carrier: carrier\n    });\n  }\n} else if (trackingNumber) {\n  results.push({\n    tracking_number: trackingNumber,\n    order_number: orderId.toString(),\n    order_name: orderName,\n    email: email.toLowerCase(),\n    carrier: carrier\n  });\n}\n\nif (results.length === 0) {\n  return [{ json: { skip: true, reason: 'No tracking number in fulfillment' } }];\n}\n\nreturn results.map(r => ({ json: r }));"
      }
    },
