    {
      "id": "7f1c2d3e-0a11-4b52-9c01-aa0000000001",
      "name": "Verify Shopify HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Verifies X-Shopify-Hmac-Sha256: base64 HMAC SHA-256 of the RAW request body, keyed with the webhook secret.\n// Needs NODE_FUNCTION_ALLOW_BUILTIN=crypto on the n8n instance and the Raw Body option on the webhook node.\n// Fails closed: a missing secret, header or raw body means the request is rejected.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst secret = $env.SHOPIFY_WEBHOOK_SECRET || '';\nconst received = String((item.json.headers || {})['x-shopify-hmac-sha256'] || '');\nlet valid = false;\nif (secret && received && item.binary && item.binary.data) {\n  const raw = await this.helpers.getBinaryDataBuffer(0, 'data');\n  const expected = crypto.createHmac('sha256', secret).update(raw).digest('base64');\n  const a = Buffer.from(expected);\n  const b = Buffer.from(received);\n  valid = a.length === b.length && crypto.timingSafeEqual(a, b);\n}\nreturn [{ json: { valid, body: valid ? item.json.body : null } }];"
      }
    },
